# Copy to .env and fill in what you have. Everything is optional; each stage has a free fallback.
# .env is git-ignored. Keys are read from the environment only and never written anywhere by JARVIS.

# --- Brain (LLM) ------------------------------------------------------------
# Tiered routing: every request is rated for complexity and starts at the cheapest tier that fits,
# escalating only when needed.  auto = rate each request; free | fast | smart = pin a tier; off = single provider.
LLM_ROUTING=auto
# Each tier is provider[:model]. auto = free: a running Ollama model, else keyword rules;
# fast: Claude Haiku (else the OpenAI fast model); smart: Claude Sonnet (else the OpenAI smart model).
LLM_TIER_FREE=auto
LLM_TIER_FAST=auto
LLM_TIER_SMART=auto
ROUTING_FAST_THRESHOLD=0.30
ROUTING_SMART_THRESHOLD=0.60
ROUTING_ESCALATE=true

# Keys and models the tiers draw from
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_SMART_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_SMART_MODEL=gpt-6-sol
OLLAMA_MODEL=qwen3:4b
# OLLAMA_SMART_MODEL=qwen3:14b
# OLLAMA_HOST=http://127.0.0.1:11434
# Pin a single provider instead of tiers (anthropic | openai | ollama | keyword); auto keeps tiers on.
LLM_PROVIDER=auto

# --- Voice (TTS) ------------------------------------------------------------
# auto = elevenlabs if ELEVENLABS_API_KEY, else macOS say, else console
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
# Pick a voice: `jarvis voices` lists the IDs on your account. Daniel (British) is the default.
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# ELEVENLABS_VOICE_NAME=Daniel
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_SPEED=1.0
TTS_CACHE=true
# SAY_VOICE=Daniel            # macOS `say -v` voice for the fallback

# --- Ears (STT) -------------------------------------------------------------
# auto = whisper if faster-whisper is installed, else google (online, via SpeechRecognition)
STT_PROVIDER=auto
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en

# --- Wake -------------------------------------------------------------------
# auto = wakeword if openWakeWord is installed, else name (always listening). Or push_to_talk.
WAKE_MODE=auto
WAKE_WORD=hey_jarvis
WAKE_THRESHOLD=0.5
WAKE_ACK=phrase               # phrase | chime | none
WAKE_ACK_TEXT=Yes, sir?

# --- Audio ------------------------------------------------------------------
# MIC_DEVICE=                 # index or name substring from `jarvis devices`; empty = system default
SILENCE_SECONDS=1.2
MAX_UTTERANCE_SECONDS=15
LISTEN_TIMEOUT_SECONDS=8
MIN_SPEECH_RMS=0.010

# --- Persona ----------------------------------------------------------------
ASSISTANT_NAME=Jarvis
USER_NAME=
HONORIFIC=sir

# --- Misc -------------------------------------------------------------------
HISTORY_TURNS=8
MAX_TOOL_ROUNDS=6
MAX_TOKENS=400
SEARCH_MAX_RESULTS=5
# JARVIS_DATA_DIR=~/.jarvis
LOG_LEVEL=WARNING
