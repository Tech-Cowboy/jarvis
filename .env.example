# Copy to .env and fill in what you have. Everything is optional; each stage has a free fallback.
# .env is git-ignored. Keys are read from the environment only and never written anywhere by Daxton AI.

# --- Brain (LLM) ------------------------------------------------------------
# Tiered routing: every request is rated for complexity and starts at the cheapest tier that fits,
# escalating only when needed.  auto = rate each request; free | fast | smart = pin a tier; off = single provider.
LLM_ROUTING=auto
# Each tier is provider[:model]. auto = free: a running Ollama model, else keyword rules;
# fast: Claude Haiku (else the OpenAI fast model); smart: Claude Sonnet (else the OpenAI smart model).
LLM_TIER_FREE=auto
LLM_TIER_FAST=auto
LLM_TIER_SMART=auto
ROUTING_FAST_THRESHOLD=0.30
ROUTING_SMART_THRESHOLD=0.60
ROUTING_ESCALATE=true

# Keys and models the tiers draw from
ANTHROPIC_API_KEY=
# Only for an organization-level key (one not created inside a workspace): Console > Settings > Workspaces
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_SMART_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_SMART_MODEL=gpt-6-sol
OLLAMA_MODEL=qwen3:4b
# OLLAMA_SMART_MODEL=qwen3:14b
# OLLAMA_HOST=http://127.0.0.1:11434
# Pin a single provider instead of tiers (anthropic | openai | ollama | keyword); auto keeps tiers on.
LLM_PROVIDER=auto

# --- Voice (TTS) ------------------------------------------------------------
# auto = elevenlabs if ELEVENLABS_API_KEY, else macOS say, else console
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
# Pick a voice: `daxton voices` lists the IDs on your account. Daniel (British) is the default.
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# ELEVENLABS_VOICE_NAME=Daniel
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_SPEED=1.0
TTS_CACHE=true
# SAY_VOICE=Daniel            # macOS `say -v` voice for the fallback

# --- Ears (STT) -------------------------------------------------------------
# auto = whisper if faster-whisper is installed, else google (online, via SpeechRecognition)
STT_PROVIDER=auto
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en

# --- Wake -------------------------------------------------------------------
# auto = name mode (say the name anywhere in a sentence) unless a wake-word model exists for the name.
# WAKE_WORD: auto | a pre-trained openWakeWord name (hey_jarvis) | path to a custom model (WAKE_WORD=~/models/hey_daxton.onnx)
WAKE_MODE=auto
WAKE_WORD=auto
WAKE_THRESHOLD=0.5
WAKE_ACK=phrase               # phrase | chime | none
WAKE_ACK_TEXT=Yes, sir?

# --- Audio ------------------------------------------------------------------
# MIC_DEVICE=                 # index or name substring from `daxton devices`; empty = system default
SILENCE_SECONDS=1.2
MAX_UTTERANCE_SECONDS=15
LISTEN_TIMEOUT_SECONDS=8
MIN_SPEECH_RMS=0.010

# --- Dashboard and the portal (docs/portal.md) ------------------------------
# Login for `daxton ui`. Empty: only this Mac's own browser is served, whatever a tunnel forwards.
# Set (12+ characters): every page, API call and socket needs the session cookie. Changing it signs everyone out.
DASHBOARD_PASSWORD=
# No domain: `daxton tunnel quick --service` publishes a random https://<words>.trycloudflare.com address.
# Your own domain (DNS on Cloudflare): set the hostname and run `daxton tunnel setup`.
# PUBLIC_HOSTNAME=daxton.example.com
# TUNNEL_NAME=daxton
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8765
# DASHBOARD_SESSION_DAYS=30
# DASHBOARD_SECRET=            # cookie signing secret; empty = generated once into ~/.daxton/dashboard.secret

# --- Conversations (ElevenLabs Conversational AI, `daxton convai setup`) ----
# Needs ELEVENLABS_API_KEY above. The agent id is kept in ~/.daxton/convai.json after setup.
CONVAI_LLM=claude-sonnet-5           # the brain ElevenLabs runs for the agent
# CONVAI_VOICE_ID=                   # defaults to ELEVENLABS_VOICE_ID
CONVAI_LOCAL=true                    # saying the name at the Mac opens a conversation on its mic and speakers
CONVAI_BARGE_IN=false                # true only with a headset: otherwise the Mac hears its own speakers
CONVAI_SILENCE_END=45                # seconds of silence before a conversation ends by itself
CONVAI_MAX_MINUTES=30

# --- Work -------------------------------------------------------------------
DAXTON_SHELL=true                    # run_command, run_python, delegate_task
# CLAUDE_CODE_BIN=/opt/homebrew/bin/claude   # when Claude Code is not on PATH
# TASKS_DIR=~/Documents/Claude/Projects/daxton-tasks
TASK_TIMEOUT_MINUTES=30

# --- Persona ----------------------------------------------------------------
ASSISTANT_NAME=Daxton
PRODUCT_NAME=Daxton AI
# ASSISTANT_ALIASES=Dax, Dexton     # other spellings speech-to-text produces for the name
USER_NAME=
HONORIFIC=sir

# --- Misc -------------------------------------------------------------------
HISTORY_TURNS=8
MAX_TOOL_ROUNDS=6
MAX_TOKENS=400
SEARCH_MAX_RESULTS=5
# DAXTON_DATA_DIR=~/.daxton
LOG_LEVEL=WARNING
